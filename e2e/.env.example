# Copy to e2e/.env (gitignored) for scratch real-environment verification and for Go tests that use docker.lan services. Environment variables override this file.
# OpsNap instance under verification
OPSNAP_BASE_URL=http://127.0.0.1:8210
# opsnap-test services on docker.internal (see deploy/test/docker-compose.yaml and docs/verification.md#test-environment)
TEST_ENV_HOST=192.168.8.141
# Shared test password, generated by `scripts/test-env.sh up` on first run
OPSNAP_TEST_PASSWORD=
# Published ports of the opsnap-test MySQL 8.0 (user root) and PostgreSQL 16 (user postgres).
# Go tests read this file through internal/pkg/testenv and skip, stating why, when a service is not configured.
TEST_ENV_MYSQL_PORT=13306
TEST_ENV_PG_PORT=15432
# Published port of a temporary MySQL 5.7 (user root), started and torn down separately from the standing
# opsnap-test compose (see docs/verification.md#test-environment); only used by the "8.0 mysqldump backs up a
# 5.7 server" integration test (internal/pkg/dump: TestRealMySQL57ExportRestore). Unset skips that test.
TEST_ENV_MYSQL57_PORT=
# SSH jump host (network channel, user opsnap) and SOCKS5 proxy (user opsnap) for the datasources round's
# runtime verification (docs/verification.md#test-environment). ssh-target has no published port: it is only
# reachable through ssh-jump. No Go test reads these yet; they document the ports for manual verification.
TEST_ENV_SSH_JUMP_PORT=12222
TEST_ENV_SOCKS5_PORT=11081
